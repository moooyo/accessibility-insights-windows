<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <MsiBasePath Condition="'$(MsiBasePath)' == ''">$(MSBuildProjectDirectory)\..\MSI\bin\x86\Release\msi</MsiBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>AccessibilityInsights.Manifest</AssemblyName>
    <RootNamespace>AccessibilityInsights.Manifest</RootNamespace>
  </PropertyGroup>

  <Import Project="..\props\prod-version.props" />
  <Import Project="..\..\build\NetFrameworkRelease.targets" />

  <ItemGroup>
    <EmbeddedResource Include="$(TargetDir)ReleaseInfo.json" LogicalName="AccessibilityInsights.Manifest.ReleaseInfo.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- NOTE: If you update this version, please also update the OctokitPath parameter in the PreBuild step that appears below -->
    <PackageReference Include="Octokit" Version="14.0.0" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\tools\scripts\create-json-for-manifest.ps1&quot; -Verbose -OctokitRelativePath Octokit\14.0.0\lib\netstandard2.0\Octokit.dll -MsiBasePath &quot;$(MsiBasePath)&quot; -IsMandatoryProdUpdate $(IsMandatoryProdUpdate) -OutputPath &quot;$(TargetDir).&quot; -OutputFile ReleaseInfo.json" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Delete Files="$(TargetDir)Octokit.dll" />
  </Target>

</Project>
