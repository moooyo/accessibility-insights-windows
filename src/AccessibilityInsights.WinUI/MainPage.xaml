<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AccessibilityInsights.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AccessibilityInsights.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <InfoBar Grid.Row="0" x:Name="ErrorBar" x:Uid="ErrorBar" Title="Operation failed"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" />
        <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="LeftCompact"
                        IsPaneOpen="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Navigation_SelectionChanged"
                        AutomationProperties.AutomationId="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="InspectNavigation" x:Uid="InspectNavigation" Tag="Inspect"
                                    Icon="Find" Content="Inspect" AutomationProperties.AutomationId="NavInspect" />
                <NavigationViewItem x:Uid="TestNavigation" Tag="Test" Icon="Accept" Content="Automated checks"
                                    AutomationProperties.AutomationId="NavTest" />
                <NavigationViewItem x:Uid="ContrastNavigation" Tag="Contrast" Icon="FontColor" Content="Color contrast"
                                    AutomationProperties.AutomationId="NavContrast" />
                <NavigationViewItem x:Uid="EventsNavigation" Tag="Events" Icon="List" Content="Events"
                                    AutomationProperties.AutomationId="NavEvents" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="SettingsNavigation" Tag="Settings" Icon="Setting" Content="Settings"
                                    AutomationProperties.AutomationId="NavSettings" />
            </NavigationView.FooterMenuItems>
            <Grid Padding="20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CommandBar Grid.Row="0" HorizontalAlignment="Left" DefaultLabelPosition="Right"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <AppBarButton x:Name="SelectionButton" x:Uid="SelectionButton" Label="Start selection" Icon="Play"
                                  Click="Selection_Click" AutomationProperties.AutomationId="StartSelection" />
                    <AppBarButton x:Uid="RunChecks" Label="Run checks" Icon="Accept" Click="RunChecks_Click"
                                  IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  AutomationProperties.AutomationId="RunChecks" />
                    <AppBarButton x:Uid="OpenSnapshot" Label="Open" Icon="OpenFile" Click="Open_Click"
                                  AutomationProperties.AutomationId="OpenSnapshot" />
                    <AppBarButton x:Uid="SaveSnapshot" Label="Save" Icon="Save" Click="Save_Click"
                                  IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  AutomationProperties.AutomationId="SaveSnapshot" />
                    <AppBarToggleButton x:Name="HighlightToggle" x:Uid="HighlightToggle" Label="Highlight" Icon="Highlight"
                                        Click="Highlight_Click" AutomationProperties.AutomationId="HighlightToggle" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Uid="FileGitHubIssue" Label="File GitHub issue" Icon="ReportHacked"
                                      Click="FileIssue_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                      AutomationProperties.AutomationId="FileGitHubIssue" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,16">
                    <TextBlock Text="{x:Bind ViewModel.SelectedElementName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="SelectedElementName" />
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Row="2" x:Name="InspectPanel" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="ElementList" ItemsSource="{x:Bind ViewModel.Elements, Mode=OneWay}"
                              SelectionChanged="ElementList_SelectionChanged" SelectionMode="Single"
                              AutomationProperties.Name="Element hierarchy" AutomationProperties.AutomationId="ElementHierarchy">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ElementRow">
                                <TextBlock Text="{x:Bind Label, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" Padding="12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="PropertyHeader" Text="Property" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" x:Uid="ValueHeader" Text="Value" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Properties, Mode=OneWay}" SelectionMode="None"
                                  AutomationProperties.Name="Element properties" AutomationProperties.AutomationId="ElementProperties">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PropertyRow">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>
                <TabView Grid.Row="2" x:Name="TestPanel" Visibility="Collapsed"
                         IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
                    <TabViewItem x:Uid="ChecksTab" Header="Automated checks" IsClosable="False"
                                 AutomationProperties.AutomationId="ChecksTab">
                        <ListView x:Name="CheckResults"
                                  ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="Single"
                                  AutomationProperties.Name="Automated check results" AutomationProperties.AutomationId="CheckResults">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RuleRow">
                                    <StackPanel Spacing="4" Padding="4,8">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Element, Mode=OneTime}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Details, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TabViewItem>
                    <TabViewItem x:Uid="TabStopsTab" Header="Tab stops" IsClosable="False" AutomationProperties.AutomationId="TabStopsTab">
                        <Grid RowSpacing="12" Padding="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="TabStopRecordButton" x:Uid="TabStopRecordButton" Content="Start tab-stop recording"
                                    Click="TabStopRecord_Click" AutomationProperties.AutomationId="RecordTabStops" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TabStops, Mode=OneWay}"
                                      SelectionChanged="TabStop_SelectionChanged"
                                      AutomationProperties.Name="Recorded tab order"
                                      AutomationProperties.AutomationId="TabStopResults">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TabStopRow">
                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem x:Uid="ScreenshotTab" Header="Screenshot" IsClosable="False" AutomationProperties.AutomationId="ScreenshotTab">
                        <Grid RowSpacing="12" Padding="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Uid="CaptureScreenshot" Content="Capture screenshot" Click="Screenshot_Click"
                                    AutomationProperties.AutomationId="CaptureScreenshot" />
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                                <Image x:Name="ScreenshotImage" Stretch="Uniform"
                                       AutomationProperties.Name="Selected application screenshot"
                                       AutomationProperties.AutomationId="ScreenshotImage" />
                            </ScrollViewer>
                        </Grid>
                    </TabViewItem>
                </TabView>
                <ScrollViewer Grid.Row="2" x:Name="ContrastPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock x:Uid="ContrastTitle" Text="Color contrast" Style="{StaticResource TitleTextBlockStyle}" />
                        <Button x:Uid="DetectColors" Content="Detect selected element colors" Click="DetectColors_Click"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                AutomationProperties.AutomationId="DetectColors" />
                        <TextBlock x:Name="ColorConfidence" AutomationProperties.AutomationId="ColorConfidence" />
                        <TextBox x:Uid="ForegroundInput" Header="Foreground (#RRGGBB)"
                                 Text="{x:Bind ViewModel.Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ForegroundColor" />
                        <TextBox x:Uid="BackgroundInput" Header="Background (#RRGGBB)"
                                 Text="{x:Bind ViewModel.Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="BackgroundColor" />
                        <TextBlock Text="{x:Bind ViewModel.ContrastError, Mode=OneWay}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ContrastValidation" />
                        <TextBlock Text="{x:Bind ViewModel.ContrastRatio, Mode=OneWay}"
                                   Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ContrastRatio" />
                        <TextBlock x:Uid="SmallTextLabel" Text="Normal text (4.5:1)" />
                        <TextBlock Text="{x:Bind ViewModel.SmallTextResult, Mode=OneWay}" AutomationProperties.AutomationId="SmallTextResult" />
                        <TextBlock x:Uid="LargeTextLabel" Text="Large text (3:1)" />
                        <TextBlock Text="{x:Bind ViewModel.LargeTextResult, Mode=OneWay}" />
                        <TextBlock x:Uid="NonTextLabel" Text="Non-text objects (3:1)" />
                        <TextBlock Text="{x:Bind ViewModel.NonTextResult, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" x:Name="EventsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RecordButton" x:Uid="RecordButton" Content="Start recording" Click="Record_Click"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                AutomationProperties.AutomationId="RecordEvents" />
                        <Button x:Uid="OpenEvents" Content="Open events" Click="OpenEvents_Click" AutomationProperties.AutomationId="OpenEvents" />
                        <Button x:Uid="SaveEvents" Content="Save events" Click="SaveEvents_Click" AutomationProperties.AutomationId="SaveEvents" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}" SelectionMode="Single"
                              AutomationProperties.Name="Recorded UI Automation events" AutomationProperties.AutomationId="EventResults">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EventRow">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Time, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind Event, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind Element, Mode=OneTime}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Details, Mode=OneTime}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="20" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock x:Uid="SettingsTitle" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="ThemePicker" x:Uid="ThemePicker" Header="Theme" SelectedIndex="0"
                                  SelectionChanged="Theme_SelectionChanged" AutomationProperties.AutomationId="ThemePicker">
                            <ComboBoxItem x:Uid="SystemTheme" Content="System default" />
                            <ComboBoxItem x:Uid="LightTheme" Content="Light" />
                            <ComboBoxItem x:Uid="DarkTheme" Content="Dark" />
                        </ComboBox>
                        <ToggleSwitch x:Name="FocusSelection" x:Uid="FocusSelection" Header="Select by keyboard focus"
                                      AutomationProperties.AutomationId="FocusSelection" />
                        <InfoBar x:Uid="MouseSelectionWarning" IsOpen="True" IsClosable="False" Severity="Warning"
                                 Title="Mouse selection is experimental"
                                 Message="Mouse-only selection has an unresolved intermittent native crash. Keep keyboard-focus selection enabled." />
                        <ToggleSwitch x:Name="ApplicationScope" x:Uid="ApplicationScope" Header="Select entire application"
                                      AutomationProperties.AutomationId="ApplicationScope" />
                        <ToggleSwitch x:Name="AlwaysOnTop" x:Uid="AlwaysOnTop" Header="Always on top" AutomationProperties.AutomationId="AlwaysOnTop" />
                        <TextBox x:Name="PauseHotkey" x:Uid="PauseHotkey" Header="Selection hotkey" Text="Shift + F5"
                                 AutomationProperties.AutomationId="PauseHotkey" />
                        <TextBox x:Name="RecordHotkey" x:Uid="RecordHotkey" Header="Recording hotkey" Text="Shift + F7"
                                 AutomationProperties.AutomationId="RecordHotkey" />
                        <TextBox x:Name="ScanHotkey" x:Uid="ScanHotkey" Header="Scan hotkey" Text="Shift + F8"
                                 AutomationProperties.AutomationId="ScanHotkey" />
                        <Button x:Uid="SaveSettings" Content="Save settings" Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveSettings" />
                        <Button x:Uid="ImportWpfSettings" Content="Import WPF settings" Click="ImportSettings_Click"
                                AutomationProperties.AutomationId="ImportWpfSettings" />
                        <TextBox x:Name="GitHubRepository" x:Uid="GitHubRepository"
                                 Header="GitHub repository" PlaceholderText="https://github.com/owner/repo"
                                 AutomationProperties.AutomationId="GitHubRepository" />
                        <TextBlock x:Uid="HighContrastNote" Text="High contrast follows the Windows contrast theme automatically."
                                   TextWrapping="Wrap" />
                        <InfoBar x:Uid="MigrationNotice" IsOpen="True" IsClosable="False" Severity="Warning" Title="Migration preview"
                                 Message="This WinUI target does not yet replace the WPF application. Azure DevOps, update, telemetry, and remaining legacy UI workflows still require migration." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="20,8"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="StatusText" />
    </Grid>
</Page>
