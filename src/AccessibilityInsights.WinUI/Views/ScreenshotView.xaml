<UserControl
    x:Class="AccessibilityInsights_WinUI.Views.ScreenshotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="240">
        <TextBlock
            x:Name="EmptyMessage"
            x:Uid="ScreenshotEmpty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Grid x:Name="Preview" Visibility="Collapsed" SizeChanged="OnPreviewSizeChanged">
            <Image
                x:Name="ScreenshotImage"
                x:Uid="ScreenshotPreview"
                Stretch="Uniform" />
            <Canvas IsHitTestVisible="False">
                <Border
                    x:Name="SelectionOutline"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="3"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
