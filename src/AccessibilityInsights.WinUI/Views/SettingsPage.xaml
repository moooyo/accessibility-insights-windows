<Page
    x:Class="AccessibilityInsights_WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccessibilityInsights_WinUI.Views"
    xmlns:winuiEx="using:WinUIEx"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="SettingsHeading" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Severity="Error" IsClosable="False"
                     AutomationProperties.AutomationId="SettingsError" />
            <InfoBar x:Uid="SettingsReleaseChannelWarning"
                     IsOpen="{x:Bind ViewModel.HasReleaseChannelChange, Mode=OneWay}"
                     Severity="Warning" IsClosable="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Left" Spacing="28" Padding="0,8,24,24">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsThemeHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsThemeDescription" TextWrapping="Wrap" />
                    <ComboBox x:Uid="SettingsFontSize"
                              SelectedIndex="{x:Bind ViewModel.FontSizeIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SettingsFontSize">
                        <ComboBoxItem x:Uid="SettingsFontSmall" />
                        <ComboBoxItem x:Uid="SettingsFontStandard" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsShortcutsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsShortcutsDescription" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Uid="SettingsShortcutActivate"
                                 Text="{x:Bind ViewModel.HotKeyForActivatingMainWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutActivate" />
                        <TextBox x:Uid="SettingsShortcutInspect" Grid.Column="1"
                                 Text="{x:Bind ViewModel.HotKeyForSnap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutInspect" />
                        <TextBox x:Uid="SettingsShortcutRecord" Grid.Row="1"
                                 Text="{x:Bind ViewModel.HotKeyForRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutRecord" />
                        <TextBox x:Uid="SettingsShortcutPause" Grid.Row="1" Grid.Column="1"
                                 Text="{x:Bind ViewModel.HotKeyForPause, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutPause" />
                        <TextBox x:Uid="SettingsShortcutParent" Grid.Row="2"
                                 Text="{x:Bind ViewModel.HotKeyForMoveToParent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutParent" />
                        <TextBox x:Uid="SettingsShortcutPreviousSibling" Grid.Row="2" Grid.Column="1"
                                 Text="{x:Bind ViewModel.HotKeyForMoveToPreviousSibling, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutPreviousSibling" />
                        <TextBox x:Uid="SettingsShortcutNextSibling" Grid.Row="3"
                                 Text="{x:Bind ViewModel.HotKeyForMoveToNextSibling, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutNextSibling" />
                        <TextBox x:Uid="SettingsShortcutFirstChild" Grid.Row="3" Grid.Column="1"
                                 Text="{x:Bind ViewModel.HotKeyForMoveToFirstChild, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutFirstChild" />
                        <TextBox x:Uid="SettingsShortcutLastChild" Grid.Row="4"
                                 Text="{x:Bind ViewModel.HotKeyForMoveToLastChild, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                 AutomationProperties.AutomationId="ShortcutLastChild" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsSelectionHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Uid="SettingsSelectionFocus"
                                  IsOn="{x:Bind ViewModel.SelectionByFocus, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SelectionByFocus" />
                    <ToggleSwitch x:Uid="SettingsSelectionMouse"
                                  IsOn="{x:Bind ViewModel.SelectionByMouse, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SelectionByMouse" />
                    <winuiEx:NumberBoxInt32 x:Name="MouseDelay"
                                            x:Uid="SettingsMouseDelay"
                                            Minimum="50" Maximum="9999"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnMouseDelayChanged"
                                            AutomationProperties.AutomationId="MouseSelectionDelay" />
                    <ComboBox x:Uid="SettingsTreeMode"
                              SelectedIndex="{x:Bind ViewModel.TreeViewModeIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="TreeViewMode">
                        <ComboBoxItem x:Uid="SettingsTreeRaw" />
                        <ComboBoxItem x:Uid="SettingsTreeControl" />
                        <ComboBoxItem x:Uid="SettingsTreeContent" />
                    </ComboBox>
                    <ToggleSwitch x:Uid="SettingsElementScope"
                                  IsOn="{x:Bind ViewModel.IsUnderElementScope, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="ElementScope" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsFeedbackHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Uid="SettingsAlwaysOnTop"
                                  IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="AlwaysOnTop" />
                    <ComboBox x:Uid="SettingsSoundFeedback"
                              SelectedIndex="{x:Bind ViewModel.SoundFeedbackIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SoundFeedback">
                        <ComboBoxItem x:Uid="SettingsSoundAuto" />
                        <ComboBoxItem x:Uid="SettingsSoundAlways" />
                        <ComboBoxItem x:Uid="SettingsSoundNever" />
                    </ComboBox>
                    <ComboBox x:Uid="SettingsHighlighter"
                              SelectedIndex="{x:Bind ViewModel.HighlighterModeIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="HighlighterMode">
                        <ComboBoxItem x:Uid="SettingsHighlighterBeakerTooltip" />
                        <ComboBoxItem x:Uid="SettingsHighlighterBeaker" />
                        <ComboBoxItem x:Uid="SettingsHighlighterTooltip" />
                        <ComboBoxItem x:Uid="SettingsHighlighterOnly" />
                        <ComboBoxItem x:Uid="SettingsTooltipOnly" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsBehaviorHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Uid="SettingsWelcome"
                                  IsOn="{x:Bind ViewModel.ShowWelcomeScreenOnLaunch, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsDisableSnapshotTests"
                                  IsOn="{x:Bind ViewModel.DisableTestsInSnapMode, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsChromium"
                                  IsOn="{x:Bind ViewModel.ShouldTestAllChromiumContent, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsAncestry"
                                  IsOn="{x:Bind ViewModel.ShowAncestry, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsAllProperties"
                                  IsOn="{x:Bind ViewModel.ShowAllProperties, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsUncertain"
                                  IsOn="{x:Bind ViewModel.ShowUncertain, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsWhitespace"
                                  IsOn="{x:Bind ViewModel.ShowWhitespaceInTextPatternViewer, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPrivacyHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Uid="SettingsTelemetry"
                                  IsOn="{x:Bind ViewModel.EnableTelemetry, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="EnableTelemetry" />
                    <ToggleSwitch x:Uid="SettingsTelemetryDialog"
                                  IsOn="{x:Bind ViewModel.ShowTelemetryDialog, Mode=TwoWay}" />
                    <ComboBox x:Uid="SettingsReleaseChannel"
                              SelectedIndex="{x:Bind ViewModel.ReleaseChannelIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="ReleaseChannel">
                        <ComboBoxItem x:Uid="SettingsChannelProduction" />
                        <ComboBoxItem x:Uid="SettingsChannelInsider" />
                        <ComboBoxItem x:Uid="SettingsChannelCanary" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPathsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Uid="SettingsTestReportPath"
                             Text="{x:Bind ViewModel.TestReportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Uid="SettingsEventRecordPath"
                             Text="{x:Bind ViewModel.EventRecordPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="SettingsStatus" />
            </StackPanel>
            <Button x:Uid="SettingsResetButton" Grid.Column="1"
                    Click="OnResetClicked"
                    AutomationProperties.AutomationId="ResetSettings" />
            <Button x:Uid="SettingsSaveButton" Grid.Column="2"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SaveSettings" />
        </Grid>
    </Grid>
</Page>
