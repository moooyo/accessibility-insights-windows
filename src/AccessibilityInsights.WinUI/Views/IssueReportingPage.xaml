<Page
    x:Class="AccessibilityInsights_WinUI.Views.IssueReportingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:issues="using:AccessibilityInsights.Core.IssueReporting"
    xmlns:local="using:AccessibilityInsights_WinUI.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="IssueReportingHeading" Style="{StaticResource TitleTextBlockStyle}" />
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Severity="Error" IsClosable="False"
                 AutomationProperties.AutomationId="IssueReportingError" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Left" Spacing="24" Padding="0,8,24,24">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="IssueReporterConfigurationHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Uid="IssueReporterSelector"
                              ItemsSource="{x:Bind ViewModel.ReporterNames}"
                              SelectedIndex="{x:Bind ViewModel.SelectedReporterIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="IssueReporterSelector" />
                </StackPanel>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind local:IssueReportingPage.BoolToVisibility(ViewModel.IsGitHubSelected), Mode=OneWay}">
                    <TextBlock x:Uid="GitHubConfigurationHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="GitHubConfigurationDescription" TextWrapping="Wrap" />
                    <TextBox x:Uid="GitHubRepositoryLink"
                             Text="{x:Bind ViewModel.GitHubRepositoryLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="GitHubRepositoryLink" />
                </StackPanel>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind local:IssueReportingPage.BoolToVisibility(ViewModel.IsAzureBoardsSelected), Mode=OneWay}">
                    <TextBlock x:Uid="AzureBoardsConfigurationHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="AzureBoardsConfigurationDescription" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="AzureBoardsServerLink"
                                 Text="{x:Bind ViewModel.AzureBoardsServerLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AzureBoardsServerLink" />
                        <Button x:Uid="AzureBoardsConnectButton" Grid.Column="1"
                                Command="{x:Bind ViewModel.ConnectAzureBoardsCommand}"
                                AutomationProperties.AutomationId="AzureBoardsConnect" />
                        <Button x:Uid="AzureBoardsDisconnectButton" Grid.Column="2"
                                Command="{x:Bind ViewModel.DisconnectAzureBoardsCommand}"
                                AutomationProperties.AutomationId="AzureBoardsDisconnect" />
                    </Grid>
                    <StackPanel Spacing="2"
                                Visibility="{x:Bind local:IssueReportingPage.BoolToVisibility(ViewModel.IsAzureBoardsConnected), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AccountEmail, Mode=OneWay}" />
                    </StackPanel>
                    <ComboBox x:Uid="AzureBoardsProject"
                              ItemsSource="{x:Bind ViewModel.Projects}"
                              SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                              SelectionChanged="OnProjectSelectionChanged"
                              AutomationProperties.AutomationId="AzureBoardsProject">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="issues:AzureDevOpsProject">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Uid="AzureBoardsTeam"
                              ItemsSource="{x:Bind ViewModel.Teams}"
                              SelectedItem="{x:Bind ViewModel.SelectedTeam, Mode=TwoWay}"
                              AutomationProperties.AutomationId="AzureBoardsTeam">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="issues:AzureDevOpsTeam">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="IssueContextHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <InfoBar x:Uid="IssueContextMissing"
                             IsOpen="{x:Bind local:IssueReportingPage.Not(ViewModel.HasPendingIssue), Mode=OneWay}"
                             Severity="Informational" IsClosable="False" />
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind local:IssueReportingPage.BoolToVisibility(ViewModel.HasPendingIssue), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.PendingIssue.ProcessName, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingIssue.RuleDescription, Mode=OneWay, FallbackValue=''}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PendingIssue.Glimpse, Mode=OneWay, FallbackValue=''}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="IssueReportingStatus" />
            </StackPanel>
            <Button x:Uid="IssueConfigurationSaveButton" Grid.Column="1"
                    Command="{x:Bind ViewModel.SaveConfigurationCommand}"
                    AutomationProperties.AutomationId="SaveIssueConfiguration" />
            <Button x:Uid="IssueFileButton" Grid.Column="2"
                    Command="{x:Bind ViewModel.FileIssueCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="FileIssue" />
        </Grid>
    </Grid>
</Page>
