<Page
    x:Class="AccessibilityInsights_WinUI.Views.ContrastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="ContrastHeading" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="ScreenPickForeground" Command="{x:Bind ViewModel.PickForegroundCommand}"
                        AutomationProperties.AutomationId="ScreenPickForeground" />
                <Button x:Uid="ScreenPickBackground" Command="{x:Bind ViewModel.PickBackgroundCommand}"
                        AutomationProperties.AutomationId="ScreenPickBackground" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ScreenPickStatus" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     IsClosable="False" Severity="Error" AutomationProperties.AutomationId="ScreenPickError" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ForegroundHeading" />
                    <ColorPicker x:Name="ForegroundPicker" x:Uid="ForegroundPicker" Color="Black" ColorChanged="OnColorChanged"
                                 IsAlphaEnabled="False" IsMoreButtonVisible="True" IsColorSliderVisible="True"
                                 AutomationProperties.AutomationId="ForegroundColor" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="BackgroundHeading" />
                    <ColorPicker x:Name="BackgroundPicker" x:Uid="BackgroundPicker" Color="White" ColorChanged="OnColorChanged"
                                 IsAlphaEnabled="False" IsMoreButtonVisible="True" IsColorSliderVisible="True"
                                 AutomationProperties.AutomationId="BackgroundColor" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="RatioText" Text="{x:Bind ViewModel.Result, Mode=OneWay}"
                       TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.AutomationId="ContrastRatio" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Page>
