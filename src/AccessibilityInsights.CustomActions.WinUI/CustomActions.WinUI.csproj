<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AccessibilityInsights.CustomActions</AssemblyName>
    <RootNamespace>AccessibilityInsights.CustomActions</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AccessibilityInsights.CustomActions\*.cs" Link="%(Filename)%(Extension)" />
    <Content Include="..\AccessibilityInsights.CustomActions.Package\CustomAction.config"
             Link="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <ProjectReference Include="..\AccessibilityInsights.SetupLibrary.Portable\SetupLibrary.Portable.csproj" />
  </ItemGroup>
</Project>
