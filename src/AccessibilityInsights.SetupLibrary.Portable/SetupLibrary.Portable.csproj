<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>AccessibilityInsights.SetupLibrary</AssemblyName>
    <RootNamespace>AccessibilityInsights.SetupLibrary</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AccessibilityInsights.SetupLibrary\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\AccessibilityInsights.SetupLibrary\REST\*.cs" Link="REST\%(Filename)%(Extension)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <ProjectReference Include="..\AccessibilityInsights.Win32.Portable\Win32.Portable.csproj" />
    <InternalsVisibleTo Include="AccessibilityInsights.UpdateEngine" />
  </ItemGroup>
</Project>
